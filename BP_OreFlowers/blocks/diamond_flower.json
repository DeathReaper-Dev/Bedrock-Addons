{
  "format_version": "1.21.10",
  "minecraft:block": {
    "description": {
      "identifier": "axiom:diamond_flower",
      "menu_category": {
        "category": "nature",
        "group": "itemGroup.name.flower"
      }
    },
    "components": {
      "minecraft:display_name": "Diamond Flower",
      "minecraft:material_instances": {
        "*": {
          "texture": "ore_flower_diamond",
          "render_method": "alpha_test",
          "face_dimming": true,
          "ambient_occlusion": false
        }
      },
      "minecraft:geometry": "minecraft:geometry.cross",
      "minecraft:collision_box": false,
      "minecraft:selection_box": { "origin": [-4, 0, -4], "size": [8, 13, 8] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.05 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 0 },
      "minecraft:light_dampening": 0,
      "minecraft:loot": "loot_tables/empty.json",
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": [
              "minecraft:grass_block",
              "minecraft:dirt",
              "minecraft:podzol",
              "minecraft:moss_block",
              "minecraft:mycelium",
              "minecraft:rooted_dirt",
              "minecraft:mud"
            ]
          }
        ]
      }
    }
  }
}
